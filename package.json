{
  "name": "dimax-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "config-check": "npx expo config --json > NUL",
    "doctor": "npx expo-doctor",
    "quality-gate": "npm run test && npm run config-check && npm run typecheck"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "^4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "^25.3.3",
    "@types/react": "^18.3.23",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
